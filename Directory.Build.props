<Project>
  <!--
    Keep this file at the repo root: it stops MSBuild's upward search from
    importing unrelated parent build props. Directory.Solution.props also
    imports these defaults so solution and direct project builds agree.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- An explicit RID selects the platform unless Platform was also supplied. -->
    <Platform Condition="'$(Platform)' == '' and '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</Platform>
    <Platform Condition="'$(Platform)' == '' and '$(RuntimeIdentifier)' == 'win-x86'">x86</Platform>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <BundleRoot Condition="'$(BundleRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'artifacts', '$(Configuration)', '$(Platform)'))</BundleRoot>
    <!-- Outputs are project-specific even outside src; let Clean track dependency copies. -->
    <TrackFileWritesShareableOutsideOfProjectDirectory>true</TrackFileWritesShareableOutsideOfProjectDirectory>
  </PropertyGroup>
</Project>
