<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A Windows TFM, not plain net8.0: the shared launch code registers the runner as a
      package through Windows.Management.Deployment.PackageManager, which comes from the
      Windows SDK projection. That projection needs a windows target. Notably it does NOT
      need the Windows App SDK, which is what lets the console host stay WinUI-free.

      The min version is the RS5 floor (Windows 10 1809), which is also the minimum for
      .NET 10 and for every Windows App SDK version this tool provisions.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The real NuGet client, used for everything that touches a feed: source discovery from
    nuget.config, version listing, download, and reading a package's declared dependencies.

    Worth the ~2.5 MB it adds. Hand-rolling this got two things wrong that mattered:
    prerelease versions compared as plain strings (so "experimental10" sorted below
    "experimental9"), and flat-container URLs built by hand 404'd on versions whose
    normalization we guessed wrong. It also hardcoded nuget.org, which meant an internal
    feed was out of reach. NuGet.Protocol fixes all three by being the same code NuGet
    itself runs.
  -->
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="6.14.0" />
  </ItemGroup>

  <!--
    Identity manifest + assets used to give the runner package identity. It lives here
    rather than in either host because both hosts can launch packaged, and it is
    PackagedRunnerLauncher (in this project) that reads it.

    Content flows to a referencing project's output, so it lands beside whichever host
    exe is running and resolves at AppContext.BaseDirectory\RunnerIdentity.
  -->
  <ItemGroup>
    <Content Include="RunnerIdentity\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
