<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ReproStudio_Runner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <OutputPath>$(BundleRoot)runner-base\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Unpackaged on purpose: the host launches this as a plain .exe so we can run
      arbitrary self-contained WASDK versions side by side (version isolation).
      This is the intended design, NOT a workaround for a launch issue.

      Self-contained on purpose: only a self-contained build loads the WASDK native
      DLLs sitting NEXT TO the exe. A framework-dependent build instead uses the
      bootstrapper to find an *installed* framework, which defeats the whole point
      (dropping a different version's DLLs next to the exe would be ignored). The
      host provisioner overlays each target version's native DLLs (native only, so
      the compiled-in managed assemblies keep matching) onto a fresh copy of the base.

      SelfContained applies the same idea to .NET itself, so the runner also carries
      its own runtime. Without it the target machine would need a matching .NET
      runtime installed, which would break xcopy deployment.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- WASDK version is overridable so the host can publish a runner per version. -->
    <WasdkVersion Condition="'$(WasdkVersion)' == ''">2.2.0</WasdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <!-- Used by the snippet compiler at runtime, not as a Runner build analyzer. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333"
                      GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <!-- Match CsWin32's metadata dependency; never resolve metadata from an SDK at runtime. -->
    <PackageReference Include="Microsoft.Windows.SDK.Win32Metadata" Version="71.0.14-preview"
                      GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WasdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
  </ItemGroup>

  <PropertyGroup>
    <!-- This is the Roslyn 5 leg of the pinned package, compatible with our Roslyn 5.3 host. -->
    <CsWin32AnalyzerDir>$(PkgMicrosoft_Windows_CsWin32)\analyzers\dotnet\roslyn5.0\cs</CsWin32AnalyzerDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ordinary copy-local references put the generator and dependencies in deps.json.
         Keep the host's Roslyn and self-contained .NET assemblies, not the analyzer's
         older System.* copies. StringTools is a MessagePack dependency that the package
         ships only with its build tool. Recheck this closure when updating CsWin32. -->
    <CsWin32RuntimeAssembly Include="$(CsWin32AnalyzerDir)\*.dll"
                            Exclude="$(CsWin32AnalyzerDir)\System.*.dll;$(CsWin32AnalyzerDir)\Microsoft.CodeAnalysis*.dll" />
    <CsWin32RuntimeAssembly Include="$(PkgMicrosoft_Windows_CsWin32)\build\tools\Microsoft.NET.StringTools.dll" />
    <Reference Include="@(CsWin32RuntimeAssembly)" Private="true" />
    <Content Include="$(PkgMicrosoft_Windows_SDK_Win32Metadata)\Windows.Win32.winmd"
             Link="CsWin32\Windows.Win32.winmd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Windows_SDK_Win32Metadata)\sdk_license.txt"
             Link="CsWin32\sdk_license.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Windows_CsWin32)\NOTICE.txt"
             Link="CsWin32\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateCsWin32RuntimeAssets" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CsWin32AnalyzerDir)\Microsoft.Windows.CsWin32.dll')"
           Text="CsWin32's Roslyn 5 generator is missing. Restore packages or update the runtime asset layout." />
    <Error Condition="!Exists('%(CsWin32RuntimeAssembly.Identity)')"
           Text="Missing CsWin32 runtime dependency: %(CsWin32RuntimeAssembly.Identity)" />
    <Error Condition="!Exists('$(PkgMicrosoft_Windows_SDK_Win32Metadata)\Windows.Win32.winmd')"
           Text="CsWin32's Windows.Win32.winmd is missing. Restore packages or update the metadata layout." />
  </Target>

  <ItemGroup>
    <!-- Carry an inferred Platform through even when the SDK strips the app RID. -->
    <ProjectReference Include="..\ReproStudio.Shared\ReproStudio.Shared.csproj" AdditionalProperties="Platform=$(Platform)" />
  </ItemGroup>

  <!--
    Delete any resources.pri left in the output.

    WinUI resolves ms-appx resources through resources.pri when that file exists, and
    otherwise through <AssemblyName>.pri. This project only ever produces the latter,
    which is the one that actually contains themeresources.xaml. A resources.pri here
    is always stale - MSIX tooling wrote one into bin at some point in the past and
    nothing cleans it up - and because it wins, the runner dies at startup with
    "Cannot locate resource from 'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'".

    That is an easy mistake to re-make, because it survives a rebuild and travels into
    runner-base and every provisioned version folder copied from it. So remove it on
    every build rather than relying on anyone remembering to clean.
  -->
  <Target Name="RemoveStaleResourcesPri" AfterTargets="Build">
    <Delete Files="$(OutDir)resources.pri" ContinueOnError="true" />
  </Target>

</Project>
