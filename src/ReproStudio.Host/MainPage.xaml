<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReproStudio_Host.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ReproStudio_Host"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Version pickers -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Text="WASDK" />

            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                AutomationProperties.Name="Windows App SDK version"
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="WinUI" />

            <ComboBox
                Grid.Column="3"
                MinWidth="190"
                AutomationProperties.Name="WinUI package"
                DisplayMemberPath="Display"
                ItemsSource="{x:Bind ViewModel.WinUiOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedWinUi, Mode=TwoWay}" />

            <Button
                Grid.Column="4"
                AutomationProperties.Name="Browse for a WinUI nupkg"
                Click="BrowseWinUi_Click"
                Content="Browse .nupkg..." />

            <CheckBox
                Grid.Column="5"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AllowPrereleaseCheckBox"
                AutomationProperties.Name="Allow prerelease versions"
                Content="Allow prerelease"
                IsChecked="{x:Bind ViewModel.AllowPrerelease, Mode=TwoWay}"
                ToolTipService.ToolTip="Include preview and experimental NuGet versions in the version lists." />
        </Grid>

        <!-- Actions: external file mode, keep-on-top, cache, relaunch -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.AutomationId="OpenFileButton"
                AutomationProperties.Name="Open external repro file"
                Click="OpenFile_Click"
                Content="Open file..." />
            <ToggleButton
                AutomationProperties.AutomationId="KeepOnTopToggle"
                AutomationProperties.Name="Keep runner on top"
                Content="Keep on top"
                IsChecked="{x:Bind ViewModel.RunnerTopmost, Mode=TwoWay}" />
            <CheckBox
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LaunchPackagedCheckBox"
                AutomationProperties.Name="Launch runner packaged with identity"
                Content="Packaged"
                IsChecked="{x:Bind ViewModel.LaunchPackaged, Mode=TwoWay}"
                ToolTipService.ToolTip="Launch the preview runner with package identity instead of unpackaged. Handy for reproing bugs that only show up when the app has identity." />
            <Button
                AutomationProperties.Name="Clear cache"
                Click="ClearCache_Click"
                Content="Clear cache" />
            <Button
                AutomationProperties.Name="Relaunch runner"
                Click="RelaunchRunner_Click"
                Content="Relaunch" />
        </StackPanel>

        <!-- Status -->
        <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!-- Trust warning: the runner executes snippets with no sandbox. -->
        <InfoBar
            Grid.Row="3"
            IsClosable="False"
            IsOpen="True"
            Severity="Warning"
            Title="Only paste code you trust"
            Message="The runner executes your XAML and C# for real. It is not sandboxed, so treat snippets like any other code you would run." />

        <!-- Editors: one tab at a time to save room for the runner window. -->
        <TabView
            x:Name="EditorTabs"
            Grid.Row="4"
            AutomationProperties.Name="Editor tabs"
            CanDragTabs="False"
            CanReorderTabs="False"
            IsAddTabButtonVisible="False"
            TabWidthMode="SizeToContent">

            <TabViewItem
                Header="XAML"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsClosable="False">
                <TextBox
                    x:Name="XamlEditor"
                    AutomationProperties.Name="XAML editor"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsReadOnly="{x:Bind ViewModel.IsExternalFileMode, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    KeyDown="Editor_KeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextChanged="XamlEditor_TextChanged"
                    TextWrapping="NoWrap" />
            </TabViewItem>

            <TabViewItem
                Header="C#"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsClosable="False">
                <TextBox
                    x:Name="CSharpEditor"
                    AutomationProperties.Name="C# editor"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsReadOnly="{x:Bind ViewModel.IsExternalFileMode, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    KeyDown="Editor_KeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextChanged="CSharpEditor_TextChanged"
                    TextWrapping="NoWrap" />
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
