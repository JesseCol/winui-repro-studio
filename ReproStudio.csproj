<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>ReproStudio</AssemblyName>
    <RootNamespace>ReproStudio_Cli</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <OutputPath>$(BundleRoot)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The project is at the root for dotnet run; only the CLI is compiled here. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <!--
      The console host, and the thing the xcopy bundle actually ships.

      Deliberately has NO Microsoft.WindowsAppSDK reference. Everything it needs is in
      the Windows SDK projection that comes with the windows TFM - including
      Windows.Management.Deployment.PackageManager, which is what registers the runner
      when a repro asks for package identity.

      That matters for two reasons:
        - Size. The console carries no WinUI runtime.
        - Diagnosis. This tool exists to chase bugs in the Windows App SDK, so the thing
          you drive it with should not itself depend on the stack under suspicion. If the
          runner will not start, the console host still runs and can say why.

      Self-contained so the target machine needs no .NET installed. The floor is Windows
      10 1809, matching the runner.
    -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\ReproStudio.Cli\**\*.cs"
             Exclude="src\ReproStudio.Cli\**\bin\**;src\ReproStudio.Cli\**\obj\**" />
    <!-- Carry an inferred Platform through even when the SDK strips the app RID. -->
    <ProjectReference Include="src\ReproStudio.Shared\ReproStudio.Shared.csproj" AdditionalProperties="Platform=$(Platform)" />
    <!-- Build the real Runner, but consume neither its assembly, NuGet assets nor
         copy-to-output content. It writes its own self-contained runner-base folder. -->
    <ProjectReference Include="src\ReproStudio.Runner\ReproStudio.Runner.csproj"
                      AdditionalProperties="Platform=$(Platform)"
                      ReferenceOutputAssembly="false" Private="false"
                      ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="samples\**\*" Link="samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="probes\**\*" Link="probes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="investigations\**\*" Link="investigations\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Never delete or track user payload files as build outputs. -->
  <Target Name="CreatePayloadDirectory" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)payload" />
  </Target>

</Project>
